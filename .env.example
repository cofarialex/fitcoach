# Másold le .env néven, és töltsd ki. A .env fájl nem kerül gitbe.

# Port, amin a szerver fut
PORT=3000

# Claude AI bekapcsolása (https://console.anthropic.com). Ha üres, a beépített szabályalapú motor működik.
ANTHROPIC_API_KEY=

# Opcionális: másik Claude modell
# AI_MODEL=claude-opus-5-5

# Opcionális: saját JWT titok (különben automatikusan generálódik a data/ mappába)
# JWT_SECRET=

# Éles futtatásnál (HTTPS mögött) kapcsold be a biztonságos sütiket
# NODE_ENV=production
